# Copie para .env e preencha os valores reais (nunca comite o .env de verdade).

# python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-aleatoria

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# String de conexao do Postgres (Supabase: Project Settings > Database > Connection string > URI)
# Deixe vazio localmente para usar o SQLite.
DATABASE_URL=

CSRF_TRUSTED_ORIGINS=
